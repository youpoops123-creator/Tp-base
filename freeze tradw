-- FAKE TOGGLE BUILDER
local function fakeToggle(posY, text)
    local f = Instance.new("Frame", main)
    f.Size = UDim2.new(1, -12, 0, 30)
    f.Position = UDim2.new(0, 6, 0, posY)
    f.BackgroundColor3 = COLORS.Frame
    f.BorderSizePixel = 0
    f.ZIndex = 4
    corner(f, 9)
    stroke(f, Color3.fromRGB(28, 28, 28))

    local fg = Instance.new("UIGradient", f)
    fg.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(22, 22, 22)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(13, 13, 13)),
    }
    fg.Rotation = 90

    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(1, -52, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 10
    lbl.TextColor3 = COLORS.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 5

    local track = Instance.new("TextButton", f)
    track.Size = UDim2.new(0, 36, 0, 17)
    track.Position = UDim2.new(1, -42, 0.5, -8.5)
    track.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
    track.Text = ""
    track.BorderSizePixel = 0
    track.AutoButtonColor = false
    track.ZIndex = 5
    corner(track, 9)
    stroke(track, Color3.fromRGB(38, 38, 38))

    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.new(0, 13, 0, 13)
    knob.Position = UDim2.new(0, 2, 0.5, -6.5)
    knob.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    knob.BorderSizePixel = 0
    knob.ZIndex = 6
    corner(knob, 7)
    stroke(knob, Color3.fromRGB(0, 0, 0), 1)

    local on = false
    track.MouseButton1Click:Connect(function()
        on = not on
        if on then
            tween(track, {BackgroundColor3 = Color3.fromRGB(44, 44, 44)}, 0.2)
            tween(knob, {Position = UDim2.new(0, 21, 0.5, -6.5), BackgroundColor3 = COLORS.Neon1}, 0.2, Enum.EasingStyle.Back)
            tween(lbl, {TextColor3 = COLORS.Green}, 0.2)
        else
            tween(track, {BackgroundColor3 = Color3.fromRGB(24, 24, 24)}, 0.2)
            tween(knob, {Position = UDim2.new(0, 2, 0.5, -6.5), BackgroundColor3 = Color3.fromRGB(70, 70, 70)}, 0.2, Enum.EasingStyle.Back)
            tween(lbl, {TextColor3 = COLORS.Text}, 0.2)
        end
    end)
end

